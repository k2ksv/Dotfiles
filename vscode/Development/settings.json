{
  "workbench.iconTheme": "material-icon-theme",
  "vsicons.dontShowNewVersionMessage": true,
  "workbench.colorCustomizations": {
    "editor.lineHighlightBackground": "#2c313c60", 
    "editor.lineHighlightBorder": "#00000000",
    "editorCursor.foreground": "#98c379",          // Neon green cursor for text windows
    "terminal.cursorForeground": "#98c379",        // Neon green cursor for the shell
    "editor.findMatchBackground": "#e5c07b40",
    "editor.findMatchHighlightBackground": "#e5c07b20"
  },

  // ==========================================
  // 📝 Typography & Text Editing
  // ==========================================
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontSize": 16,
  "editor.lineHeight": 24, // Increased to 24 for a proportional, readable aspect ratio at font size 16
  "editor.fontLigatures": true, // Switched to true to enable beautiful connected symbols (like => and ===)
  "editor.wordWrap": "on",
  "editor.padding.top": 8,

  // ==========================================
  // 🌈 Guides, Line Highlights & Indentation
  // ==========================================
  "editor.renderLineHighlight": "all", // Changed from 'gutter' to 'all' so your line highlight block actually shows up
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.indentation": true,
  "editor.matchBrackets": "always",
  "editor.renderWhitespace": "boundary",
  "editor.tabSize": 2,

  // ==========================================
  // 🕶️ UI Interface, Layout, & Clean Space
  // ==========================================
  "workbench.activityBar.location": "top",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": true,
  "window.customTitleBarVisibility": "windowed",
  "window.zoomLevel": 1,
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.stickyScroll.enabled": false,
  "explorer.confirmDragAndDrop": false,

  // ==========================================
  // 🏃 Dynamic Motion & Smooth Scrolling
  // ==========================================
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,

  // ==========================================
  // 🐚 Integrated Shell & Terminal Layout
  // ==========================================
  "terminal.integrated.defaultProfile.windows": "MSYS2 UCRT64",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash",
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login", "-i"]
    },
    "bash (MSYS2)": {
      "path": "C:\\msys64\\usr\\bin\\bash.exe",
      "args": ["--login", "-i"],
      "env": { "CHERE_INVOKING": "1" }
    },
    "MSYS2 UCRT64": {
      "path": "C:\\msys64\\usr\\bin\\bash.exe",
      "args": ["--login", "-i"],
      "env": {
        "MSYSTEM": "UCRT64",
        "CHERE_INVOKING": "1"
      }
    }
  },
  "terminal.integrated.profiles.linux": {
    "bash": { "path": "/usr/bin/bash", "icon": "terminal-bash" },
    "zsh": { "path": "/usr/bin/zsh" },
    "fish": { "path": "fish" },
    "tmux": { "path": "tmux", "icon": "terminal-tmux" },
    "pwsh": { "path": "pwsh", "icon": "terminal-powershell" }
  },
  
  // ==========================================
  // 🎛️ Vim Mode & Cursor Settings
  // ==========================================
  "editor.lineNumbers": "relative",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.timeout": 200,
  "vim.smartRelativeLine": true,
  "vim.leader": " ",
  "vim.cursorStylePerMode": true,
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.visual": "block",
  "vim.cursorStylePerMode.replace": "underline",
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-c>": false,
    "<C-v>": false,
    "<C-z>": false,
    "<C-y>": false,
    "<C-p>": false,
    "<C-x>": false,
    "<C-b>": false,
    "<C-s>": false,
    "<C-d>": false,
    "<C-w>": false,
    "<C-r>": false,
    "<C-t>": false,
    "<C-n>": false,
    "<C-l>": false,
    "<C-k>": false
  },
  

  // ==========================================
  // ⚡ IntelliSense, Autocomplete & Emmet
  // ==========================================
  "files.autoSave": "afterDelay",
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "always",
  "scm.diffDecorations": "all",
  "editor.mouseWheelZoom": true,
  "python.createEnvironment.trigger": "off",
  "chat.disableAIFeatures": true,
  "search.smartCase": true,
  "search.followSymlinks": false,
  "editor.suggestOnTriggerCharacters": true,
  "editor.inlineSuggest.enabled": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "off",
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.suggest.preview": false,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.inlineSuggest.showToolbar": "never",
  "editor.snippetSuggestions": "top",
  "editor.quickSuggestions": {
    "comments": false,
    "strings": true,
    "other": true
  },
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "django-html": "html"
  },
  "[cpp]": {
    "editor.wordBasedSuggestions": "off"
  },
  "workbench.settings.applyToAllProfiles": [],
  "workbench.colorTheme": "Dark Chai",
  "json.schemaDownload.trustedDomains": {
    "https://aka.ms": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  }
}
